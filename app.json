{
  "expo": {
    "name": "Little Grocery List",
    "slug": "little-grocery-list",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7F8F4"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F4"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.yourname.littlegrocerylist"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#52765C"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "037b6139-3882-4e0c-b0fb-0c45765ec9de"
      }
    }
  }
}
